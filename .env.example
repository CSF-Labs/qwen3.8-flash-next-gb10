# The host directory mounted read-only at /models in the container.
MODELS_DIR=${HOME}/models
# Subfolder beneath MODELS_DIR containing the downloaded checkpoint.
MODEL_FOLDER=Qwen3.8-Flash-Next-NVFP4
BIND_ADDRESS=127.0.0.1
PORT=8000
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.80
PLE_WORKERS=32
PLE_MADVISE=random
EXACT_TOPK=1
# Optional optimization for the default MTP=2 speculative decoder. Set to 1 to
# restrict MTP proposals to the bundled 65,536-token draft vocabulary.
ENABLE_REDUCED_DRAFT_VOCAB=0
# Override only after checking patch compatibility:
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
